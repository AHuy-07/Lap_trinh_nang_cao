<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.sellerController.AddProductsController" spacing="20.0" stylesheets="@../../style.css" styleClass="seller-form-root">
    <children>
        <VBox styleClass="seller-form-card">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="seller-toolbar">
                    <Button alignment="CENTER_LEFT" graphicTextGap="8.0" onAction="#handleBackToDashboard" styleClass="seller-ghost-button" text="Quay lại quản lý">
                        <graphic>
                            <SVGPath content="M 10 2 L 2 10 L 10 18" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="2.5" />
                        </graphic>
                    </Button>
                </HBox>

                <Label styleClass="seller-form-title" text="Thêm sản phẩm mới" style="-fx-font-family: System"/>
                <Label styleClass="seller-form-subtitle" text="Điền thông tin chi tiết để đưa sản phẩm lên sàn đấu giá." />

                <Label fx:id="status" managed="false" styleClass="seller-status-error" text="" visible="false" />

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <TextField fx:id="nameInput" promptText="Tên vật phẩm..." styleClass="seller-input" HBox.hgrow="ALWAYS" />
                    <ChoiceBox fx:id="categoryBox" prefHeight="44.0" prefWidth="160.0" styleClass="seller-input" value="art">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Art" />
                                <String fx:value="Electronic" />
                                <String fx:value="Jewelry" />
                                <String fx:value="Vehicle" />
                                <String fx:value="Artifact" />
                            </FXCollections>
                        </items>
                    </ChoiceBox>
                </HBox>

            <TextArea fx:id="descInput" prefRowCount="4" promptText="Mô tả ngắn gọn..." styleClass="seller-input" wrapText="true">
                <VBox.margin>
                    <Insets top="4.0" />
                </VBox.margin>
            </TextArea>

                <Button maxWidth="Infinity" onAction="#handleAddProducts" styleClass="seller-primary-button" text="Thêm sản phẩm" />
            </children>
        </VBox>
    </children>
</VBox>
