<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="1280.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.sellerController.SellerProductsController" stylesheets="@../../style.css" styleClass="seller-form-root">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0">
        <children>
            <Button mnemonicParsing="false" onAction="#switchToDashboard" styleClass="seller-ghost-button" text="← Quay lại Dashboard">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
                <padding>
                    <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                </padding>
            </Button>

            <Region HBox.hgrow="ALWAYS" />

            <Label styleClass="seller-form-title" text="Quản lý sản phẩm" style="-fx-font-family: System"/>
        </children>
    </HBox>

    <VBox spacing="20.0" styleClass="seller-pane-card" VBox.vgrow="ALWAYS">
        <children>

            <HBox alignment="CENTER_LEFT">
                <children>
                    <VBox spacing="3.0">
                        <children>
                            <Label styleClass="seller-pane-title" text="Danh sách sản phẩm" style="-fx-font-family: System"/>
                            <Label styleClass="seller-pane-subtitle" text="Các sản phẩm bạn đã đăng ký để mang đi đấu giá" />
                        </children>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button mnemonicParsing="false" onAction="#switchToAddProduct" styleClass="seller-primary-button" text="+ Thêm sản phẩm mới">
                        <font>
                            <Font name="System Bold" size="15.0" />
                        </font>
                        <padding>
                            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                        </padding>
                    </Button>
                </children>
            </HBox>

            <TableView fx:id="tableMyProducts" styleClass="auction-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProductId" prefWidth="140.0" text="Mã sản phẩm" />
                    <TableColumn fx:id="colProductName" prefWidth="300.0" text="Tên sản phẩm" />
                    <TableColumn fx:id="colProductType" prefWidth="180.0" text="Loại sản phẩm" />
                    <TableColumn fx:id="colProductStatus" prefWidth="180.0" text="Trạng thái" />
                    <TableColumn fx:id="colProductWinPrice" prefWidth="180.0" text="Giá thắng (VNĐ)" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

        </children>
    </VBox>

</VBox>