<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.sellerController.SellerDashboardController">
    <children>
        <HBox prefHeight="800.0" prefWidth="1280.0">
            <children>

                <VBox maxWidth="280.0" minWidth="280.0" prefWidth="280.0" style="-fx-background-color: #2b323e;" HBox.hgrow="NEVER">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #00a8e8;">
                            <padding>
                                <Insets left="20.0" />
                            </padding>
                            <children>
                                <Label text="Seller Panel" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #242a34;">
                            <padding>
                                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                            </padding>
                            <children>
                                <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#788195" scaleX="0.8" scaleY="0.8" />
                                <TextField promptText="Search..." style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #788195;" />
                            </children>
                        </HBox>

                        <VBox spacing="5.0">
                            <padding>
                                <Insets top="20.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0" style="-fx-background-color: #242a34;">
                                    <padding><Insets left="20.0" /></padding>
                                    <children>
                                        <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" fill="#00a8e8" />
                                        <Label text="Phòng đấu giá (Main)" textFill="WHITE">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                    </children>
                                </HBox>

                                <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#switchToWalletView" prefHeight="40.0" prefWidth="280.0" style="-fx-background-color: transparent; -fx-text-fill: #9aa2b1; -fx-cursor: hand;" text="Ví Nạp / Rút">
                                    <graphic>
                                        <SVGPath content="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" fill="#9aa2b1" />
                                    </graphic>
                                    <padding><Insets left="20.0" /></padding>
                                    <font><Font size="16.0" /></font>
                                </Button>

                                <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#switchToProductView" prefHeight="40.0" prefWidth="280.0" style="-fx-background-color: transparent; -fx-text-fill: #9aa2b1; -fx-cursor: hand;" text="Quản lý Sản phẩm">
                                    <graphic>
                                        <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" fill="#9aa2b1" />
                                    </graphic>
                                    <padding><Insets left="20.0" /></padding>
                                    <font><Font size="16.0" /></font>
                                </Button>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <VBox spacing="15.0" style="-fx-padding: 20;">
                            <children>
                                <Label text="ACCOUNT" textFill="#5d6677">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Circle fill="#a0aab5" radius="15.0" />
                                        <VBox>
                                            <children>
                                                <Label fx:id="currentUserName" text="Seller Account" textFill="WHITE" />
                                                <Label text="Online" textFill="#00a8e8">
                                                    <font><Font size="11.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox style="-fx-background-color: #f4f7f6;" HBox.hgrow="ALWAYS">
                    <children>

                        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <padding>
                                <Insets left="30.0" right="30.0" />
                            </padding>
                            <children>
                                <Label text="Dashboard  &gt;  Danh sách phòng đấu giá" textFill="#788195">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#logOut" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand; -fx-font-weight: bold;" text="Log out">
                                    <graphic>
                                        <SVGPath content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" fill="#e74c3c" />
                                    </graphic>
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                        <VBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                            </padding>
                            <children>

                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="DANH SÁCH PHÒNG ĐẤU GIÁ CỦA TÔI" textFill="#2c3e50">
                                            <font>
                                                <Font name="System Bold" size="24.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />

                                        <HBox spacing="15.0">
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#reload" prefHeight="35.0" style="-fx-background-color: white; -fx-border-color: #d1d8e0; -fx-border-radius: 4; -fx-text-fill: #5d6677; -fx-cursor: hand;" text="Làm mới (Reload)">
                                                    <graphic>
                                                        <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" fill="#5d6677" scaleX="0.8" scaleY="0.8" />
                                                    </graphic>
                                                </Button>
                                                <Button mnemonicParsing="false" onAction="#switchToCreateRoom" prefHeight="35.0" style="-fx-background-color: #00a8e8; -fx-text-fill: white; -fx-background-radius: 4; -fx-cursor: hand;" text="+ Tạo phòng mới">
                                                    <font>
                                                        <Font name="System Bold" size="14.0" />
                                                    </font>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <TableView fx:id="tableMyRooms" style="-fx-background-color: white; -fx-border-color: #e5e8ed; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRoomId" prefWidth="120.0" text="Mã phòng" />
                                        <TableColumn fx:id="colRoomName" prefWidth="280.0" text="Tên phòng đấu giá" />
                                        <TableColumn fx:id="colStatus" prefWidth="140.0" text="Trạng thái" />
                                        <TableColumn fx:id="colBeginTime" prefWidth="160.0" text="Bắt đầu" />
                                        <TableColumn fx:id="colEndTime" prefWidth="160.0" text="Kết thúc" />
                                        <TableColumn fx:id="colAction" prefWidth="140.0" text="Thao tác" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox fx:id="notificationBox" alignment="CENTER" managed="false" maxHeight="50" maxWidth="450" style="-fx-background-color: #2ecc71; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);" visible="false" StackPane.alignment="TOP_CENTER">
            <StackPane.margin>
                <Insets top="20.0" />
            </StackPane.margin>
            <children>
                <Label fx:id="lblNotification" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Phòng đã được duyệt!" />
            </children>
        </HBox>
    </children>
</StackPane>
