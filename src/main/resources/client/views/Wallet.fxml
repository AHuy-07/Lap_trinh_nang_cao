<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox fx:controller="client.controllers.WalletController"
      stylesheets="@../style.css"
      styleClass="wallet-root"
      spacing="20" alignment="TOP_CENTER" prefWidth="780" prefHeight="800"
      xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <!-- Tiêu đề trang -->
    <StackPane>
        <Label text="Quản Lý Ví Đấu Giá" styleClass="wallet-page-title" style="-fx-font-family: 'System';"/>
        <Button text="⬅ Quay lại" onAction="#goBack" StackPane.alignment="CENTER_LEFT"
                styleClass="wallet-btn-back"/>
        <Label fx:id="status" managed="false" styleClass="wallet-status-error" text="" visible="false" />
    </StackPane>

    <!-- Khung hiển thị số dư -->
    <HBox spacing="15" alignment="CENTER" styleClass="wallet-balance-card">
        <Label text="Số dư khả dụng:" styleClass="wallet-balance-subtitle"/>
        <Label fx:id="lblBalance" styleClass="wallet-balance-amount" style="-fx-font-family: 'System';"/>
    </HBox>

    <!-- Khu vực chức năng Nạp / Rút -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="wallet-tabs">
        <tabs>
            <!-- TAB: NẠP TIỀN -->
            <Tab text="📥 Nạp Tiền">
                <VBox spacing="20" styleClass="wallet-tab-content">
                    <GridPane hgap="15" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Số tiền (VNĐ):" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               styleClass="wallet-form-label"/>
                        <TextField fx:id="txtDepositAmount" promptText="Nhập số tiền cần nạp..."
                                   GridPane.columnIndex="1" GridPane.rowIndex="0" prefHeight="35"
                                   styleClass="wallet-input"/>

                        <Label text="Nguồn tiền:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               styleClass="wallet-form-label"/>
                        <ComboBox fx:id="cbDepositMethod" promptText="-- Chọn phương thức thanh toán --"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" prefHeight="35"
                                  styleClass="wallet-combo"/>
                    </GridPane>

                    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                        <Label fx:id="lblDepositError" styleClass="wallet-error" text=""/>
                        <Button text="Hủy" styleClass="wallet-btn-cancel"/>
                        <Button fx:id="btnConfirmDeposit" text="Xác Nhận Nạp Tiền" styleClass="wallet-btn-confirm"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- TAB: RÚT TIỀN -->
            <Tab text="📤 Rút Tiền">
                <VBox spacing="20" styleClass="wallet-tab-content">
                    <GridPane hgap="15" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Số tiền rút (VNĐ):" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               styleClass="wallet-form-label"/>
                        <TextField fx:id="txtWithdrawAmount" promptText="Nhập số tiền cần rút..."
                                   GridPane.columnIndex="1" GridPane.rowIndex="0" prefHeight="35"
                                   styleClass="wallet-input"/>

                        <Label text="Chuyển về:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               styleClass="wallet-form-label"/>
                        <ComboBox fx:id="cbWithdrawBank" promptText="-- Chọn ngân hàng đã liên kết --"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" prefHeight="35"
                                  styleClass="wallet-combo"/>
                    </GridPane>

                    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                        <Label fx:id="lblWithdrawError" styleClass="wallet-error" text=""/>
                        <Button text="Hủy" styleClass="wallet-btn-cancel"/>
                        <Button fx:id="btnConfirmWithdraw" text="Xác Nhận Rút Tiền" styleClass="wallet-btn-confirm"/>
                    </HBox>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>

    <!-- Bảng lịch sử giao dịch -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-padding: 10 0 0 0;">
        <Label text="Lịch sử giao dịch gần đây" styleClass="wallet-section-title" style="-fx-font-family: 'Time New Roman';"/>
        <TableView fx:id="tblTransactionHistory" prefHeight="200" VBox.vgrow="ALWAYS"
                   styleClass="wallet-table">
            <columns>
                <TableColumn fx:id="colDate" text="Thời gian" prefWidth="160"/>
                <TableColumn fx:id="colType" text="Loại Giao Dịch" prefWidth="120"/>
                <TableColumn fx:id="colAmount" text="Số tiền (VNĐ)" prefWidth="160"/>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>