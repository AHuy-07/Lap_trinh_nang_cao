<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" styleClass="auction-room-root" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.bidderController.AuctionRoomController">

    <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="auction-header">
            <Button onAction="#handleBackToDashboard" styleClass="auction-back-btn" text="← Quay lại" />
            <VBox HBox.hgrow="ALWAYS">
                <Label fx:id="roomNameLabel" style="-fx-font-family:'Times New Roman';" styleClass="auction-room-title" text="Tên phòng đấu giá" />
                <Label fx:id="statusLabel" styleClass="room-status-label" text="Đang kết nối..." />
            </VBox>
        </HBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <VBox maxWidth="340.0" minWidth="340.0" prefWidth="340.0" spacing="12.0" styleClass="auction-details-card">

                <Label styleClass="room-info-section-label" text="THÔNG TIN CHI TIẾT" />

                <GridPane hgap="8.0" vgap="10.0">
                    <Label style="-fx-font-weight: bold;" text="Mã phòng:" textFill="#475569" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="roomIdLabel" style="-fx-font-weight: bold;" text="-" textFill="#1e293b" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label style="-fx-font-weight: bold;" text="Người bán:" textFill="#475569" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="sellerNameLabel" style="-fx-font-weight: bold;" text="-" textFill="#1e293b" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label style="-fx-font-weight: bold;" text="Giá khởi điểm:" textFill="#475569" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="startingPriceLabel" style="-fx-font-weight: bold;" text="0 VNĐ" textFill="#1e293b" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label style="-fx-font-weight: bold;" text="Bước giá:" textFill="#475569" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="bidStepLabel" style="-fx-font-weight: bold;" text="0 VNĐ" textFill="#1e293b" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label style="-fx-font-weight: bold;" text="Người giữ giá:" textFill="#475569" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="winnerLabel" style="-fx-font-weight: bold;" text="Chưa có" textFill="#2563eb" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
                        <ColumnConstraints minWidth="120.0" prefWidth="170.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="22.0" />
                        <RowConstraints prefHeight="22.0" />
                        <RowConstraints prefHeight="22.0" />
                        <RowConstraints prefHeight="22.0" />
                        <RowConstraints prefHeight="22.0" />
                    </rowConstraints>
                </GridPane>

                <Separator style="-fx-padding: 5 0;" />

                <HBox spacing="10">
                    <VBox spacing="4" styleClass="current-price-card" HBox.hgrow="ALWAYS">
                        <Label styleClass="current-price-title" text="GIÁ HIỆN TẠI" />
                        <Label fx:id="currentPriceLabel" style="-fx-font-family:'System';" styleClass="current-price-value" text="0 VNĐ" />
                    </VBox>
                </HBox>
                 <VBox spacing="4" styleClass="timer-card">
                     <Label styleClass="timer-title" text="THỜI GIAN" />
                     <Label fx:id="countdownLabel" style="-fx-font-family:'System';" styleClass="timer-value" text="00:00:00" />
                 </VBox>

                <VBox spacing="8" style="-fx-padding: 5 0 0 0;">
                    <Label styleClass="bid-section-title" text="ĐẶT GIÁ CỦA BẠN" />
                    <TextField fx:id="bidAmountField" prefHeight="36.0" promptText="Nhập số tiền..." styleClass="bid-input" />

                    <HBox spacing="8">
                        <Button maxWidth="Infinity" onAction="#handleRecommendedBid" prefHeight="30.0" styleClass="bid-step-btn" text="+1 Bước" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleBidStep2" prefHeight="30.0" styleClass="bid-step-btn" text="+2 Bước" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleBidStep5" prefHeight="30.0" styleClass="bid-step-btn" text="+5 Bước" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <Button maxWidth="Infinity" onAction="#handlePlaceBid" prefHeight="40.0" styleClass="btn-place-bid" text="XÁC NHẬN ĐẶT GIÁ" />

                <VBox spacing="8" styleClass="auto-bid-panel">
                    <Label styleClass="auto-bid-section-title" text="ĐẤU GIÁ TỰ ĐỘNG (AUTO-BID)" />
                    <TextField fx:id="autoBidLimitField" prefHeight="32.0" promptText="Giới hạn tối đa (VD: 500.000)" styleClass="bid-input" />
                    <Button fx:id="btnToggleAutoBid" maxWidth="288.0" onAction="#handleToggleAutoBid" prefHeight="25.0" prefWidth="288.0" styleClass="btn-auto-bid-activate" text="Kích hoạt Auto-Bid" />
                    <Label styleClass="auto-bid-hint" text="* Hệ thống tự động nâng giá khi bạn bị vượt, không vượt quá mức tối đa." wrapText="true" />
                </VBox>

            </VBox>

            <VBox spacing="20.0" HBox.hgrow="ALWAYS">

                <VBox styleClass="auction-chart-card" VBox.vgrow="ALWAYS">
                    <Label styleClass="auction-chart-title" text="BIẾN ĐỘNG GIÁ" />
                    <Separator />
                    <LineChart fx:id="priceChart" animated="false" legendVisible="false" styleClass="auction-chart" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <NumberAxis animated="false" autoRanging="true" label="Thời gian đã trôi qua (phút)" side="BOTTOM" fx:id="xAxis" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis autoRanging="true" forceZeroInRange="false" label="Giá (VNĐ)" side="LEFT" />
                        </yAxis>
                    </LineChart>
                </VBox>

                <VBox prefHeight="200.0" styleClass="auction-history-card">
                    <Label styleClass="auction-history-title" text="LỊCH SỬ ĐẤU GIÁ" />
                    <Separator />
                    <TextArea fx:id="bidHistoryArea" editable="false" promptText="Chưa có lượt ra giá nào..." styleClass="bid-history-area" VBox.vgrow="ALWAYS" />
                </VBox>

            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
