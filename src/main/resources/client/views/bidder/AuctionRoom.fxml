<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
    Canvas: 1024 x 768 — khớp BASE_WIDTH/BASE_HEIGHT, Group sẽ scale toàn bộ.
    Không dùng ScrollPane vì Group scale là đủ — tránh mọi bug width=0 của GridPane.
    Toàn bộ nội dung cột trái được tính toán vừa khít chiều cao khả dụng:
      768 - 15(top) - 15(bot) - 64(header) - 10(spacing×2) = 654px cho body
-->
<AnchorPane prefHeight="768.0" prefWidth="1024.0"
            style="-fx-background-color: #f4f7f6;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.bidderController.AuctionRoomController">

    <VBox spacing="10.0"
          AnchorPane.topAnchor="15.0"
          AnchorPane.bottomAnchor="15.0"
          AnchorPane.leftAnchor="15.0"
          AnchorPane.rightAnchor="15.0">

        <!-- ══ HEADER ══ -->
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              style="-fx-background-color: #2c3e50; -fx-padding: 10 15 10 15; -fx-background-radius: 10;">
            <Button onAction="#handleBackToDashboard"
                    style="-fx-background-color: #34495e; -fx-text-fill: white;"
                    text="Quay lại" />
            <VBox HBox.hgrow="ALWAYS">
                <Label fx:id="roomNameLabel" text="Tên phòng đấu giá" textFill="WHITE">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
                <Label fx:id="statusLabel" text="Đang kết nối..." textFill="#bdc3c7" />
            </VBox>
        </HBox>

        <!-- ══ BODY ══ -->
        <HBox spacing="15.0" VBox.vgrow="ALWAYS">

            <!-- ── CỘT TRÁI: VBox thẳng, prefWidth cứng, không ScrollPane ── -->
            <VBox prefWidth="285.0" minWidth="285.0" maxWidth="285.0" spacing="7.0"
                  style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">

                <Label style="-fx-font-weight: bold; -fx-font-size: 11px;"
                       text="THÔNG TIN CHI TIẾT" textFill="#7f8c8d" />

                <!--
                    GridPane: prefWidth cứng = 261 (285 - 12padding×2)
                    Đảm bảo columns luôn có kích thước đúng, không bao giờ collapse.
                    Giữ đúng rowIndex gốc: 0=Mã phòng, 1=Người bán, 2=Giá khởi điểm,
                    3=(trống), 4=Bước giá, 5=Người giữ giá
                -->
                <GridPane hgap="8.0" vgap="7.0" prefWidth="261.0">
                    <Label text="Mã phòng:"       GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="roomIdLabel"    text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Người bán:"      GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="sellerNameLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Giá khởi điểm:"  GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="startingPriceLabel" text="0 VNĐ" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Bước giá:"        GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="bidStepLabel"   text="0 VNĐ" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label text="Người giữ giá:"   GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <Label fx:id="winnerLabel" style="-fx-font-weight: bold;" text="Chưa có"
                           textFill="#2980b9" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <columnConstraints>
                        <ColumnConstraints prefWidth="120.0" minWidth="110.0" />
                        <ColumnConstraints prefWidth="133.0" minWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="20.0" minHeight="20.0" />
                        <RowConstraints prefHeight="20.0" minHeight="20.0" />
                        <RowConstraints prefHeight="20.0" minHeight="20.0" />
                        <RowConstraints prefHeight="6.0"  minHeight="6.0"  />
                        <RowConstraints prefHeight="20.0" minHeight="20.0" />
                        <RowConstraints prefHeight="20.0" minHeight="20.0" />
                    </rowConstraints>
                </GridPane>

                <!-- Giá hiện tại -->
                <VBox spacing="2"
                      style="-fx-background-color: #ebf5fb; -fx-padding: 8 12 8 12; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold;"
                           text="GIÁ HIỆN TẠI" textFill="#2980b9" />
                    <Label fx:id="currentPriceLabel"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"
                           text="0 VNĐ" textFill="#e67e22" />
                </VBox>

                <!-- Thời gian còn lại -->
                <VBox spacing="2"
                      style="-fx-background-color: #fef9e7; -fx-padding: 8 12 8 12; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold;"
                           text="THỜI GIAN CÒN LẠI" textFill="#f1c40f" />
                    <Label fx:id="countdownLabel"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"
                           text="00:00:00" textFill="#e74c3c" />
                </VBox>

                <!-- Đặt giá -->
                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold;" text="ĐẶT GIÁ CỦA BẠN" />
                    <TextField fx:id="bidAmountField" prefHeight="32.0"
                               promptText="Nhập số tiền..." style="-fx-font-size: 13px;" />
                    <HBox spacing="8">
                        <Button maxWidth="Infinity" onAction="#handleRecommendedBid"
                                prefHeight="25.0" prefWidth="91.0"
                                style="-fx-background-color: #f1c40f;" text="+1 Bước"
                                HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox spacing="8">
                        <Button maxWidth="Infinity" onAction="#handleBidStep2"
                                prefHeight="25.0" prefWidth="61.0"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white;"
                                text="+2 Bước" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleBidStep5"
                                style="-fx-background-color: #d35400; -fx-text-fill: white;"
                                text="+5 Bước" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <Button maxWidth="Infinity" onAction="#handlePlaceBid" prefHeight="30.0"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="ĐẶT GIÁ NGAY" />

                <!-- Auto-Bid -->
                <VBox spacing="6"
                      style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 12px;"
                           text="ĐẤU GIÁ TỰ ĐỘNG (AUTO-BID)" textFill="#1e293b" />
                    <TextField fx:id="autoBidLimitField" prefHeight="30.0"
                               promptText="Nhập giới hạn tối đa (VD: 500000)"
                               style="-fx-font-size: 12px;" />
                    <Button fx:id="btnToggleAutoBid" maxWidth="Infinity"
                            onAction="#handleToggleAutoBid" prefHeight="30.0"
                            style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                            text="Kích hoạt Auto-Bid" />
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #64748b; -fx-font-style: italic;"
                           text="* Hệ thống tự động nâng giá khi bạn bị vượt, không quá mức tối đa."
                           wrapText="true" />
                </VBox>

            </VBox>

            <!-- ── CỘT PHẢI: giữ nguyên 100% — vgrow/chart không đổi ── -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS">

                <VBox VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <Label style="-fx-font-weight: bold;" text="BIẾN ĐỘNG GIÁ" textFill="#34495e" />
                    <AreaChart fx:id="priceChart" animated="false" legendVisible="false"
                               VBox.vgrow="ALWAYS">
                        <xAxis>
                            <NumberAxis autoRanging="false" label="Thời gian (phút)"
                                        lowerBound="0" side="BOTTOM" tickUnit="10" upperBound="30"
                                        fx:id="xAxis" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Giá (VNĐ)" side="LEFT" />
                        </yAxis>
                    </AreaChart>
                </VBox>

                <VBox prefHeight="160.0"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <Label style="-fx-font-weight: bold;" text="LỊCH SỬ ĐẤU GIÁ" textFill="#34495e" />
                    <TextArea fx:id="bidHistoryArea" editable="false"
                              promptText="Lịch sử hiển thị ở đây..."
                              style="-fx-font-family: 'Consolas'; -fx-font-size: 13px;"
                              VBox.vgrow="ALWAYS" />
                </VBox>

            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
