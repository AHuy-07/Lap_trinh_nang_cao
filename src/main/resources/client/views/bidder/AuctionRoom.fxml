<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.bidderController.AuctionRoomController">

    <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 15; -fx-background-radius: 10;">
            <Button onAction="#handleBackToDashboard" style="-fx-background-color: #34495e; -fx-text-fill: white;" text="Quay lại" />
            <VBox HBox.hgrow="ALWAYS">
                <Label fx:id="roomNameLabel" text="Tên phòng đấu giá" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Label fx:id="statusLabel" text="Đang kết nối..." textFill="#bdc3c7" />
            </VBox>
        </HBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <Label style="-fx-font-weight: bold;" text="THÔNG TIN CHI TIẾT" textFill="#7f8c8d" />

                <GridPane hgap="10.0" vgap="12.0">
                    <Label text="Mã phòng:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="roomIdLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Người bán:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="sellerNameLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Giá khởi điểm:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="startingPriceLabel" text="0 VNĐ" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Bước giá:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="bidStepLabel" text="0 VNĐ" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label text="Người giữ giá:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <Label fx:id="winnerLabel" style="-fx-font-weight: bold;" text="Chưa có" textFill="#2980b9" GridPane.columnIndex="1" GridPane.rowIndex="5" />
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <VBox spacing="5" style="-fx-background-color: #ebf5fb; -fx-padding: 15; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="GIÁ HIỆN TẠI" textFill="#2980b9" />
                    <Label fx:id="currentPriceLabel" style="-fx-font-size: 26px; -fx-font-weight: bold;" text="0 VNĐ" textFill="#e67e22" />
                </VBox>

                <VBox spacing="5" style="-fx-background-color: #fef9e7; -fx-padding: 15; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="THỜI GIAN CÒN LẠI" textFill="#f1c40f" />
                    <Label fx:id="countdownLabel" style="-fx-font-size: 26px; -fx-font-weight: bold;" text="00:00:00" textFill="#e74c3c" />
                </VBox>

                <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Label style="-fx-font-weight: bold;" text="ĐẶT GIÁ CỦA BẠN" />
                    <TextField fx:id="bidAmountField" prefHeight="40.0" promptText="Nhập số tiền..." style="-fx-font-size: 14px;" />
                    <HBox spacing="10">
                        <Button maxWidth="Infinity" onAction="#handleRecommendedBid" prefHeight="25.0" prefWidth="91.0" style="-fx-background-color: #f1c40f;" text="+1 Bước" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox spacing="10">
                        <Button maxWidth="Infinity" onAction="#handleBidStep2" prefHeight="25.0" prefWidth="61.0" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="+2 Bước" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleBidStep5" style="-fx-background-color: #d35400; -fx-text-fill: white;" text="+5 Bước" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>
                  <Button maxWidth="Infinity" onAction="#handlePlaceBid" prefHeight="30.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="ĐẶT GIÁ NGAY" />
            </VBox>

            <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);" VBox.vgrow="ALWAYS">
                    <Label style="-fx-font-weight: bold;" text="BIẾN ĐỘNG GIÁ" textFill="#34495e" />
                    <AreaChart fx:id="priceChart" animated="false" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <NumberAxis autoRanging="false" label="Thời gian (phút)" lowerBound="0" side="BOTTOM" tickUnit="10" upperBound="30" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Giá (VNĐ)" side="LEFT" />
                        </yAxis>
                    </AreaChart>
                </VBox>

                <VBox prefHeight="200.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <Label style="-fx-font-weight: bold;" text="LỊCH SỬ ĐẤU GIÁ" textFill="#34495e" />
                    <TextArea fx:id="bidHistoryArea" editable="false" promptText="Lịch sử hiển thị ở đây..." style="-fx-font-family: 'Consolas'; -fx-font-size: 13px;" VBox.vgrow="ALWAYS" />
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
