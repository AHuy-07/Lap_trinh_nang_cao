<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="800.0" prefWidth="1280.0" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.bidderController.WonProductsController">

    <VBox spacing="16.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="24.0">

        <!-- Header: Nút Quay lại và Tiêu đề -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Button onAction="#handleBackToDashboard" styleClass="wallet-btn-back" text="⬅ Quay lại" />
            <Label text="Sản phẩm đã đấu giá thành công">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
                <HBox.margin>
                    <Insets left="10.0" />
                </HBox.margin>
            </Label>
        </HBox>

        <Label style="-fx-text-fill: #34495e; -fx-font-style: italic;" text="Danh sách các sản phẩm bạn đã chiến thắng trong các phiên đấu giá." />

        <!-- Cụm nút hành động -->
        <HBox spacing="12.0">
            <Button onAction="#handleRefreshList" style="-fx-background-color: #D4AF37; -fx-text-fill: white; -fx-cursor: hand;" styleClass="nav-item" text="🔄 Làm mới danh sách" />
        </HBox>

        <!-- Bảng hiển thị danh sách sản phẩm -->
        <TableView fx:id="wonProductsTable" styleClass="auction-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="productIdColumn" prefWidth="100.0" text="Mã SP" />

                <TableColumn fx:id="productNameColumn" prefWidth="280.0" text="Tên sản phẩm" />

                <TableColumn fx:id="sellerNameColumn" prefWidth="180.0" text="Người bán" />

                <TableColumn fx:id="winningPriceColumn" prefWidth="180.0" text="Giá trúng thầu" />

                <TableColumn fx:id="wonTimeColumn" prefWidth="210.0" text="Thời gian trúng thầu" />
            </columns>
            <!-- Cho phép bảng tự động dãn cột nếu còn khoảng trống -->
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </VBox>
   <padding>
      <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
   </padding>

</StackPane>
