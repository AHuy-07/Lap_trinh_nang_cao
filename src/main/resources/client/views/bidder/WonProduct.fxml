<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="client.controllers.bidderController.WonProductsController"
            prefHeight="768.0"
            prefWidth="1024.0">

    <VBox spacing="16.0"
          AnchorPane.topAnchor="24.0"
          AnchorPane.leftAnchor="24.0"
          AnchorPane.rightAnchor="24.0"
          AnchorPane.bottomAnchor="24.0">

        <!-- Header: Nút Quay lại và Tiêu đề -->
        <HBox spacing="16.0" alignment="CENTER_LEFT">
            <Button text="⬅ Quay lại"
                    onAction="#handleBackToDashboard"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Label text="Sản phẩm đã đấu giá thành công">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
                <HBox.margin>
                    <Insets left="10.0"/>
                </HBox.margin>
            </Label>
        </HBox>

        <Label text="Danh sách các sản phẩm bạn đã chiến thắng trong các phiên đấu giá."
               style="-fx-text-fill: #34495e; -fx-font-style: italic;"/>

        <!-- Cụm nút hành động -->
        <HBox spacing="12.0">
            <Button text="🔄 Làm mới danh sách"
                    onAction="#handleRefreshList"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>

        <!-- Bảng hiển thị danh sách sản phẩm -->
        <TableView fx:id="wonProductsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="productIdColumn"
                             text="Mã SP"
                             prefWidth="100.0"/>

                <TableColumn fx:id="productNameColumn"
                             text="Tên sản phẩm"
                             prefWidth="220.0"/>

                <TableColumn fx:id="sellerNameColumn"
                             text="Người bán"
                             prefWidth="150.0"/>

                <TableColumn fx:id="winningPriceColumn"
                             text="Giá trúng thầu"
                             prefWidth="150.0"/>

                <TableColumn fx:id="wonTimeColumn"
                             text="Thời gian trúng thầu"
                             prefWidth="180.0"/>
            </columns>
            <!-- Cho phép bảng tự động dãn cột nếu còn khoảng trống -->
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </VBox>

</AnchorPane>
