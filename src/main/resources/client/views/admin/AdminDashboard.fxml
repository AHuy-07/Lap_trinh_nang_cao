<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.AdminDashboardController">
    <children>
        <HBox prefHeight="800.0" prefWidth="1280.0">
            <children>

                <VBox maxWidth="280.0" minWidth="280.0" prefWidth="280.0" style="-fx-background-color: #1e293b;" HBox.hgrow="NEVER">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #0f172a;">
                            <padding>
                                <Insets left="20.0" />
                            </padding>
                            <children>
                                <Label text="Admin Panel" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <VBox spacing="5.0">
                            <padding>
                                <Insets top="20.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" prefHeight="45.0" spacing="15.0" style="-fx-background-color: #334155; -fx-background-radius: 0 25 25 0;">
                                    <padding><Insets left="20.0" /></padding>
                                    <children>
                                        <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="#38bdf8" />
                                        <Label text="Duyệt Phòng Đấu Giá" textFill="WHITE">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                    </children>
                                    <VBox.margin>
                                        <Insets right="15.0" />
                                    </VBox.margin>
                                </HBox>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <VBox spacing="15.0" style="-fx-padding: 20;">
                            <children>
                                <Label text="HỆ THỐNG" textFill="#64748b">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Circle fill="#94a3b8" radius="15.0" />
                                        <VBox>
                                            <children>
                                                <Label text="Administrator" textFill="#e2e8f0">
                                                    <font><Font name="System Bold" size="14.0" /></font>
                                                </Label>
                                                <Label text="Toàn quyền" textFill="#38bdf8">
                                                    <font><Font size="12.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">
                    <children>

                        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 5, 0, 0, 2);">
                            <padding>
                                <Insets left="30.0" right="30.0" />
                            </padding>
                            <children>
                                <Label text="Dashboard  &gt;  Quản lý duyệt phòng" textFill="#64748b">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />

                                <Button mnemonicParsing="false" onAction="#logOut" style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-cursor: hand; -fx-font-weight: bold;" text="Log out">
                                    <graphic>
                                        <SVGPath content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" fill="#ef4444" />
                                    </graphic>
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                        <VBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                            </padding>
                            <children>

                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="QUẢN LÝ DUYỆT PHÒNG ĐẤU GIÁ" textFill="#0f172a">
                                                    <font>
                                                        <Font name="System Bold" size="26.0" />
                                                    </font>
                                                </Label>
                                                <Label text="Danh sách các phòng đang chờ Admin phê duyệt để hoạt động" textFill="#64748b">
                                                    <font>
                                                        <Font size="16.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <Region HBox.hgrow="ALWAYS" />

                                        <Button mnemonicParsing="false" onAction="#reload" prefHeight="38.0" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-text-fill: #334155; -fx-cursor: hand;" text="Làm mới danh sách">
                                            <graphic>
                                                <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" fill="#475569" scaleX="0.8" scaleY="0.8" />
                                            </graphic>
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>

                                <TableView fx:id="tablePendingRooms" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 5, 0, 0, 2);" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRoomId" prefWidth="120.0" text="Mã Phòng" />
                                        <TableColumn fx:id="colRoomName" prefWidth="300.0" text="Tên Phòng Đấu Giá" />
                                        <TableColumn fx:id="colProductId" prefWidth="150.0" text="Mã Sản Phẩm" />
                                        <TableColumn fx:id="colPrice" prefWidth="180.0" text="Giá Khởi Điểm (VNĐ)" />
                                        <TableColumn fx:id="colAction" prefWidth="230.0" text="Thao Tác" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>